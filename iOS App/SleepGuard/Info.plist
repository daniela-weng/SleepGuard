<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for CoreBluetooth on iOS 13+ -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>SleepGuard needs Bluetooth to connect to your breathing sensor and track your sleep.</string>

    <!-- Required for local notifications (apnea alerts) -->
    <key>UIBackgroundModes</key>
    <array>
        <string>bluetooth-central</string>
    </array>
</dict>
</plist>
